    "m_ObjectId": "79b5ba3d8eda4379a870b52b651e22e8",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "HeightFog (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -275.0,
            "y": 746.0000610351563,
            "width": 213.00003051757813,
            "height": 382.00006103515627
        }
    },
    "m_Slots": [
        {
            "m_Id": "7251edb5cad64095ade2d6b80a8d5971"
        },
        {
            "m_Id": "425f5f29f1bb45fa972e07b83c5e0736"
        },
        {
            "m_Id": "6f65684ae6324f11a470c90e1cb3cbd4"
        },
        {
            "m_Id": "f5d4b901368e4011b86cc42fdf37e901"
        },
        {
            "m_Id": "830ca5a5df1a430bb4f909ccc6ed76f5"
        },
        {
            "m_Id": "8945a4989bf4472bbea84cb10f95d917"
        },
        {
            "m_Id": "dfa50808aa244edb8ca0f95c7412527b"
        },
        {
            "m_Id": "4cbda852621d4469bb228036451e8122"
        },
        {
            "m_Id": "efca61cffa714d908f0b78adf8c873c1"
        },
        {
            "m_Id": "5576b4ce16664eda8f94b8b961f58b28"
        },
        {
            "m_Id": "477a1d97b6f5449a91bb2eb5ae72e068"
        },
        {
            "m_Id": "07d3a941c977427aac644417c65e9a41"
        },
        {
            "m_Id": "edb7a42478034236b90a61526cf8a4e7"
        },
        {
            "m_Id": "4520b8b739e941339a7fa776a57c8a98"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "HeightFog",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 wp = ComputeWorldSpacePosition(UV, RawDepth, UNITY_MATRIX_I_VP);\r\nfloat3 cam = _WorldSpaceCameraPos;\r\nfloat dist = distance(wp, cam);\r\n\r\n// névoa um pouco mais \"pesada\" perto do chão\r\nfloat h = max(wp.y - FogBaseHeight, 0.0);\r\nfloat heightFactor = exp(-h * HeightFalloff);\r\n\r\n// ruído 2D animado\r\nfloat2 p = wp.xz * NoiseScale + Time * Speed;\r\nfloat2 i = floor(p);\r\nfloat2 f = frac(p);\r\nf = f * f * (3.0 - 2.0 * f);\r\nfloat2 k = float2(127.1, 311.7);\r\nfloat a = frac(sin(dot(i, k)) * 43758.5453);\r\nfloat b = frac(sin(dot(i + float2(1, 0), k)) * 43758.5453);\r\nfloat c = frac(sin(dot(i + float2(0, 1), k)) * 43758.5453);\r\nfloat d = frac(sin(dot(i + float2(1, 1), k)) * 43758.5453);\r\nfloat n = lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);\r\n\r\n// distância \"efetiva\": ruído e altura deslocam o quanto de névoa há\r\nfloat fogDist = dist * (1.0 + HeightAmount * heightFactor);\r\nfogDist *= lerp(1.0, 0.7 + n * 0.6, NoiseAmount);\r\n\r\nfloat fog = smoothstep(FogStart, FogEnd, fogDist);\r\nOut = lerp(SceneColor, FogColor, fog);"
}

